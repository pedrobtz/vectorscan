#!/bin/sh

set -e

mkdir -p src

PKG_CPPFLAGS=""
PKG_LIBS=""
FOUND_HS=no
BUNDLED_SOURCE_DIR="src/vendor/vectorscan"
BUNDLED_BUILD_DIR="${TMPDIR:-/tmp}/vectorscan-build-$$"
BUNDLED_INSTALL_DIR="src/vendor/vectorscan-install"

append_flags_from_prefix() {
  prefix="$1"
  if [ -f "$prefix/include/hs/hs.h" ] && [ -d "$prefix/lib" ]; then
    PKG_CPPFLAGS="-DHAVE_HS -I$prefix/include"
    PKG_LIBS="-L$prefix/lib -lhs"
    FOUND_HS=yes
  fi
}

find_system_vectorscan() {
  if [ -n "$VECTORSCAN_INCLUDE_DIR" ] && [ -n "$VECTORSCAN_LIB_DIR" ]; then
    if [ -f "$VECTORSCAN_INCLUDE_DIR/hs/hs.h" ]; then
      PKG_CPPFLAGS="-DHAVE_HS -I$VECTORSCAN_INCLUDE_DIR"
      PKG_LIBS="-L$VECTORSCAN_LIB_DIR -lhs"
      FOUND_HS=yes
      return
    fi
  fi

  if command -v pkg-config >/dev/null 2>&1; then
    if pkg-config --exists libhs; then
      PKG_CPPFLAGS="-DHAVE_HS $(pkg-config --cflags libhs)"
      PKG_LIBS="$(pkg-config --libs libhs)"
      FOUND_HS=yes
      return
    elif pkg-config --exists vectorscan; then
      PKG_CPPFLAGS="-DHAVE_HS $(pkg-config --cflags vectorscan)"
      PKG_LIBS="$(pkg-config --libs vectorscan)"
      FOUND_HS=yes
      return
    fi
  fi

  if command -v brew >/dev/null 2>&1; then
    brew_prefix="$(brew --prefix vectorscan 2>/dev/null || true)"
    if [ -n "$brew_prefix" ]; then
      append_flags_from_prefix "$brew_prefix"
      if [ "$FOUND_HS" = yes ]; then
        return
      fi
    fi
  fi

  for prefix in /opt/homebrew /usr/local /usr /opt/local; do
    append_flags_from_prefix "$prefix"
    if [ "$FOUND_HS" = yes ]; then
      return
    fi
  done
}

# R CMD config reports a compiler as a command line, e.g. "ccache clang -arch
# arm64". CMake wants the compiler, an optional launcher, and the rest as flags.
compiler_cmake_args() {
  lang="$1"
  # shellcheck disable=SC2086
  set -- $2
  case "$1" in
    ccache|*/ccache|sccache|*/sccache)
      printf ' -DCMAKE_%s_COMPILER_LAUNCHER=%s' "$lang" "$1"
      shift
      ;;
  esac
  printf ' -DCMAKE_%s_COMPILER=%s' "$lang" "$1"
}

# The flags part of an R CMD config compiler line, minus any -std= (the
# vendored build sets its own language standard).
compiler_flags() {
  # shellcheck disable=SC2086
  set -- $1
  case "$1" in
    ccache|*/ccache|sccache|*/sccache) shift ;;
  esac
  shift
  flags=""
  for word in "$@"; do
    case "$word" in
      -std=*) ;;
      *) flags="$flags $word" ;;
    esac
  done
  printf '%s' "${flags# }"
}

# Build the vendored libraries with R's compilers, so they use the same C++
# standard library as the package code that links against them.
detect_r_compilers() {
  cc_line=""
  cxx_line=""
  compiler_args=""
  cc_flags=""
  cxx_flags=""
  if [ -n "$R_HOME" ]; then
    cc_line="$("$R_HOME/bin/R" CMD config CC)"
    cxx_line="$("$R_HOME/bin/R" CMD config CXX17)"
    if [ -z "$cxx_line" ]; then
      cxx_line="$("$R_HOME/bin/R" CMD config CXX)"
    fi
    compiler_args="$(compiler_cmake_args C "$cc_line") $(compiler_cmake_args CXX "$cxx_line")"
    cc_flags="$(compiler_flags "$cc_line")"
    cxx_flags="$(compiler_flags "$cxx_line")"
  fi
}

build_bundled_vectorscan() {
  if [ ! -f "$BUNDLED_SOURCE_DIR/src/hs.h" ]; then
    echo "configure: bundled Vectorscan source is missing at $BUNDLED_SOURCE_DIR"
    return 1
  fi

  if ! command -v cmake >/dev/null 2>&1; then
    echo "configure: cmake is required to build bundled Vectorscan"
    return 1
  fi

  # ragel is optional: without it the vendored CMake uses the pre-generated
  # src/parser/*.rl.cpp sources.
  #
  # CMAKE_INSTALL_LIBDIR=lib: GNUInstallDirs picks lib64 on Fedora, RHEL and
  # openSUSE, but the install is private and read back from lib/ below.
  #
  # NO_SIMDE_IN_FAT: since 5.4.13 the x86-64 fat runtime also builds a SIMDe
  # variant for CPUs without SSE4.2, which needs the SIMDe headers -- a git
  # submodule that the release archive leaves empty and that is not vendored.
  # Leaving it out gives the same variants as 5.4.12.

  cmake_args="
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON
    -DBUILD_SHARED_LIBS=OFF
    -DBUILD_STATIC_LIBS=ON
    -DBUILD_UNIT=OFF
    -DBUILD_TOOLS=OFF
    -DBUILD_EXAMPLES=OFF
    -DBUILD_BENCHMARKS=OFF
    -DBUILD_DOC=OFF
    -DHS_C_FLAGS=-Wno-error
    -DHS_CXX_FLAGS=-Wno-error
    -DNO_SIMDE_IN_FAT=ON
    -DCMAKE_INSTALL_LIBDIR=lib
  "

  # Boost headers: an explicit root, else the BH package (LinkingTo), else
  # Homebrew. Passed as its own argument so a path with spaces survives, and
  # with system paths off: the vendored boost.cmake's first lookup would
  # otherwise take any system Boost ahead of BOOST_ROOT.
  boost_root="$VECTORSCAN_BOOST_ROOT"
  if [ -z "$boost_root" ] && [ -n "$R_HOME" ]; then
    boost_root="$("$R_HOME/bin/Rscript" -e 'cat(system.file(package = "BH"))' 2>/dev/null || true)"
  fi
  if [ -z "$boost_root" ] && command -v brew >/dev/null 2>&1; then
    boost_root="$(brew --prefix boost 2>/dev/null || true)"
  fi

  cmake_args="$cmake_args $compiler_args"

  # The x86-64 fat runtime (one build per microarchitecture, chosen at run
  # time) relies on ELF ifunc and ELF symbol renaming, so upstream supports it
  # on Linux and FreeBSD only. Elsewhere -- macOS on Intel, in particular --
  # build a single x86-64-v2 (SSE4.2) library instead.
  #
  # Nor does it survive AddressSanitizer: clang puts instrumented globals in
  # COMDAT groups keyed by a per-source hash that the per-microarchitecture
  # copies share, so the linker discards all but one copy's data. When R's
  # compilers carry -fsanitize=address, build a single library too.
  fat_runtime=yes
  case "$(uname -s)" in
    Linux|FreeBSD) ;;
    *) fat_runtime=no ;;
  esac
  case "$cc_line $cxx_line" in
    *-fsanitize=*address*) fat_runtime=no ;;
  esac
  if [ "$fat_runtime" = no ]; then
    cmake_args="$cmake_args -DFAT_RUNTIME=OFF"
  fi

  if [ -n "$VECTORSCAN_CMAKE_ARGS" ]; then
    cmake_args="$cmake_args $VECTORSCAN_CMAKE_ARGS"
  fi

  jobs="${VECTORSCAN_BUILD_JOBS:-2}"
  install_prefix="$(pwd)/$BUNDLED_INSTALL_DIR"

  rm -rf "$BUNDLED_BUILD_DIR" "$BUNDLED_INSTALL_DIR"

  echo "configure: building bundled Vectorscan"
  echo "configure: C compiler: ${cc_line:-cmake default}"
  echo "configure: C++ compiler: ${cxx_line:-cmake default}"
  echo "configure: Boost root: ${boost_root:-none}"
  # The function runs in an `if !` context, where set -e is off, so every
  # step checks its own status.
  #
  # R exports its package compile flags (e.g. CFLAGS="-g -O2 -Wall
  # -pedantic") to configure, and CMake would adopt them. They are for R
  # package code, not the vendored build: Vectorscan's compiler checks run
  # with -Werror, and -pedantic fails its ifunc check, disabling the fat
  # runtime build. The subshell drops them for CMake only.
  # shellcheck disable=SC2086
  if ! (
    unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
    cmake -S "$BUNDLED_SOURCE_DIR" -B "$BUNDLED_BUILD_DIR" $cmake_args \
      ${boost_root:+"-DBOOST_ROOT=$boost_root"} \
      ${boost_root:+"-DBoost_NO_SYSTEM_PATHS=ON"} \
      ${cc_flags:+"-DCMAKE_C_FLAGS=$cc_flags"} \
      ${cxx_flags:+"-DCMAKE_CXX_FLAGS=$cxx_flags"}
  ); then
    # The failing compiler check is the last one CMake ran; show its log.
    for log in "$BUNDLED_BUILD_DIR/CMakeFiles/CMakeConfigureLog.yaml" \
      "$BUNDLED_BUILD_DIR/CMakeFiles/CMakeError.log"; do
      if [ -f "$log" ]; then
        echo "configure: last lines of $log:"
        tail -n 80 "$log"
        break
      fi
    done
    rm -rf "$BUNDLED_BUILD_DIR"
    return 1
  fi
  cmake --build "$BUNDLED_BUILD_DIR" --target hs --config Release -j "$jobs" &&
    cmake --build "$BUNDLED_BUILD_DIR" --target hs_runtime --config Release -j "$jobs" &&
    cmake --install "$BUNDLED_BUILD_DIR" --prefix "$install_prefix"
  status=$?
  rm -rf "$BUNDLED_BUILD_DIR"
  if [ "$status" -ne 0 ]; then
    return 1
  fi

  if [ ! -f "$BUNDLED_INSTALL_DIR/lib/libhs.a" ]; then
    echo "configure: bundled Vectorscan build did not produce install/lib/libhs.a"
    return 1
  fi

  PKG_CPPFLAGS="-DHAVE_HS -Ivendor/vectorscan-install/include"
  PKG_LIBS="vendor/vectorscan-install/lib/libhs.a vendor/vectorscan-install/lib/libhs_runtime.a"
  FOUND_HS=yes
}

allow_stubs() {
  [ "$VECTORSCAN_ALLOW_STUBS" = "true" ] || [ "$VECTORSCAN_ALLOW_STUBS" = "1" ]
}

if [ "$VECTORSCAN_USE_SYSTEM" = "true" ] || [ "$VECTORSCAN_USE_SYSTEM" = "1" ]; then
  find_system_vectorscan
  # Same rule as the bundled path: no library means a failed install, not a
  # silent stub build, unless stubs were asked for.
  if [ "$FOUND_HS" = no ]; then
    if allow_stubs; then
      echo "configure: no system libhs found; runtime stubs because VECTORSCAN_ALLOW_STUBS is set"
    else
      echo "configure: VECTORSCAN_USE_SYSTEM is set but no Vectorscan/Hyperscan libhs was found"
      echo "configure: install it (pkg-config libhs), set VECTORSCAN_INCLUDE_DIR and VECTORSCAN_LIB_DIR, or unset VECTORSCAN_USE_SYSTEM"
      exit 1
    fi
  fi
else
  detect_r_compilers
  if ! build_bundled_vectorscan; then
    if allow_stubs; then
      echo "configure: falling back to runtime stubs because VECTORSCAN_ALLOW_STUBS is set"
    else
      echo "configure: failed to build bundled Vectorscan"
      echo "configure: install cmake, or set VECTORSCAN_USE_SYSTEM=true"
      exit 1
    fi
  fi
fi

# -- PCRE2, for hs_capture() -------------------------------------------------
#
# VECTORSCAN_PCRE2 picks the route: auto (default: system, else vendored,
# else none), system, vendored or none. The system PCRE2 is preferred: on
# Linux it is the very library R loads. The vendored copy is built with every
# symbol hidden (HAVE_VISIBILITY=OFF leaves PCRE2_EXPORT empty on top of
# PCRE2's own hidden preset), so that our calls can never be resolved to a
# different PCRE2 already loaded in the process. See
# .agents/capture-groups.md.

PCRE2_SOURCE_DIR="src/vendor/pcre2"
PCRE2_BUILD_DIR="${TMPDIR:-/tmp}/vectorscan-pcre2-build-$$"
PCRE2_INSTALL_DIR="src/vendor/pcre2-install"
PCRE2_MIN_VERSION="10.34"
FOUND_PCRE2=no

# 0 when version $1 is at least $2 (both major.minor).
version_at_least() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    split(a, x, "."); split(b, y, ".")
    exit !((x[1] + 0 > y[1] + 0) || (x[1] + 0 == y[1] + 0 && x[2] + 0 >= y[2] + 0))
  }'
}

find_system_pcre2() {
  if command -v pkg-config >/dev/null 2>&1 &&
    pkg-config --atleast-version="$PCRE2_MIN_VERSION" libpcre2-8 2>/dev/null; then
    PCRE2_CPPFLAGS="$(pkg-config --cflags libpcre2-8)"
    PCRE2_LIBS="$(pkg-config --libs libpcre2-8)"
    PCRE2_VERSION="$(pkg-config --modversion libpcre2-8)"
    FOUND_PCRE2=system
    return 0
  fi
  if command -v pcre2-config >/dev/null 2>&1; then
    version="$(pcre2-config --version)"
    if version_at_least "$version" "$PCRE2_MIN_VERSION"; then
      PCRE2_CPPFLAGS="$(pcre2-config --cflags)"
      PCRE2_LIBS="$(pcre2-config --libs8)"
      PCRE2_VERSION="$version"
      FOUND_PCRE2=system
      return 0
    fi
  fi
  return 1
}

build_vendored_pcre2() {
  if [ ! -f "$PCRE2_SOURCE_DIR/CMakeLists.txt" ]; then
    echo "configure: vendored PCRE2 is missing at $PCRE2_SOURCE_DIR"
    return 1
  fi
  if ! command -v cmake >/dev/null 2>&1; then
    echo "configure: cmake is required to build the vendored PCRE2"
    return 1
  fi

  rm -rf "$PCRE2_BUILD_DIR" "$PCRE2_INSTALL_DIR"
  echo "configure: building vendored PCRE2"
  # shellcheck disable=SC2086
  (
    unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
    cmake -S "$PCRE2_SOURCE_DIR" -B "$PCRE2_BUILD_DIR" $compiler_args \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_SHARED_LIBS=OFF \
      -DBUILD_STATIC_LIBS=ON \
      -DPCRE2_STATIC_PIC=ON \
      -DPCRE2_BUILD_PCRE2GREP=OFF \
      -DPCRE2_BUILD_TESTS=OFF \
      -DPCRE2_SUPPORT_JIT=ON \
      -DPCRE2_SUPPORT_UNICODE=ON \
      -DHAVE_VISIBILITY=OFF \
      -DCMAKE_INSTALL_LIBDIR=lib \
      ${cc_flags:+"-DCMAKE_C_FLAGS=$cc_flags"} &&
      cmake --build "$PCRE2_BUILD_DIR" --target pcre2-8-static --config Release \
        -j "${VECTORSCAN_BUILD_JOBS:-2}" &&
      # Only the 8-bit static library is built, so copy it and its header
      # rather than `cmake --install`, which would install every target.
      mkdir -p "$PCRE2_INSTALL_DIR/lib" "$PCRE2_INSTALL_DIR/include" &&
      cp "$PCRE2_BUILD_DIR/libpcre2-8.a" "$PCRE2_INSTALL_DIR/lib/" &&
      cp "$PCRE2_BUILD_DIR/interface/pcre2.h" "$PCRE2_INSTALL_DIR/include/"
  )
  status=$?
  rm -rf "$PCRE2_BUILD_DIR"
  if [ "$status" -ne 0 ] || [ ! -f "$PCRE2_INSTALL_DIR/lib/libpcre2-8.a" ]; then
    echo "configure: vendored PCRE2 build failed"
    return 1
  fi

  PCRE2_CPPFLAGS="-DPCRE2_STATIC -Ivendor/pcre2-install/include"
  PCRE2_LIBS="vendor/pcre2-install/lib/libpcre2-8.a"
  header="$PCRE2_INSTALL_DIR/include/pcre2.h"
  PCRE2_VERSION="$(sed -n 's/^#define PCRE2_MAJOR[[:space:]]*\([0-9]*\).*/\1/p' "$header").$(sed -n 's/^#define PCRE2_MINOR[[:space:]]*\([0-9]*\).*/\1/p' "$header")"
  FOUND_PCRE2=vendored
  return 0
}

pcre2_mode="${VECTORSCAN_PCRE2:-auto}"
case "$pcre2_mode" in
  auto)
    find_system_pcre2 || { detect_r_compilers; build_vendored_pcre2; } || true
    ;;
  system)
    if ! find_system_pcre2; then
      echo "configure: VECTORSCAN_PCRE2=system but no PCRE2 >= $PCRE2_MIN_VERSION was found (pkg-config libpcre2-8, pcre2-config)"
      exit 1
    fi
    ;;
  vendored)
    detect_r_compilers
    if ! build_vendored_pcre2; then
      echo "configure: VECTORSCAN_PCRE2=vendored but the vendored PCRE2 did not build"
      exit 1
    fi
    ;;
  none) ;;
  *)
    echo "configure: VECTORSCAN_PCRE2 must be auto, system, vendored or none (got '$pcre2_mode')"
    exit 1
    ;;
esac

if [ "$FOUND_PCRE2" != no ]; then
  PKG_CPPFLAGS="$PKG_CPPFLAGS -DHAVE_PCRE2 -DPCRE2_CODE_UNIT_WIDTH=8 $PCRE2_CPPFLAGS"
  if [ "$FOUND_PCRE2" = vendored ]; then
    PKG_CPPFLAGS="$PKG_CPPFLAGS -DVCTRSN_PCRE2_VENDORED"
  fi
  PKG_LIBS="$PKG_LIBS $PCRE2_LIBS"
  echo "configure: PCRE2 $PCRE2_VERSION ($FOUND_PCRE2)"
else
  echo "configure: PCRE2 not available; hs_capture() will be unavailable"
fi

cat > src/Makevars <<EOF
CXX_STD = CXX17
PKG_CPPFLAGS = $PKG_CPPFLAGS
PKG_LIBS = $PKG_LIBS
EOF

if [ "$FOUND_HS" = yes ]; then
  echo "configure: Vectorscan/Hyperscan support enabled"
else
  echo "configure: Vectorscan/Hyperscan not found; building package with runtime stubs"
  echo "configure: set VECTORSCAN_ALLOW_STUBS only for wrapper development"
fi

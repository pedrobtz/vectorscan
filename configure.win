#!/bin/sh

set -e

mkdir -p src

PKG_CPPFLAGS=""
PKG_LIBS=""
FOUND_HS=no
BUNDLED_SOURCE_DIR="src/vendor/vectorscan"
BUNDLED_BUILD_DIR="${TMPDIR:-/tmp}/vectorscan-build-$$"
BUNDLED_INSTALL_DIR="src/vendor/vectorscan-install"

if [ -n "$VECTORSCAN_INCLUDE_DIR" ] && [ -n "$VECTORSCAN_LIB_DIR" ]; then
  if [ -f "$VECTORSCAN_INCLUDE_DIR/hs/hs.h" ]; then
    PKG_CPPFLAGS="-DHAVE_HS -I$VECTORSCAN_INCLUDE_DIR"
    PKG_LIBS="-L$VECTORSCAN_LIB_DIR -lhs"
    FOUND_HS=yes
  fi
fi

if [ "$FOUND_HS" = no ] && [ "$VECTORSCAN_USE_SYSTEM" != "true" ] && [ "$VECTORSCAN_USE_SYSTEM" != "1" ]; then
  if [ ! -f "$BUNDLED_SOURCE_DIR/src/hs.h" ]; then
    echo "configure.win: bundled Vectorscan source is missing at $BUNDLED_SOURCE_DIR"
  elif ! command -v cmake >/dev/null 2>&1; then
    echo "configure.win: cmake is required to build bundled Vectorscan"
  else
    # ragel is optional: without it the vendored CMake uses the pre-generated
    # src/parser/*.rl.cpp sources.
    #
    # FAT_RUNTIME=OFF: the x86-64 fat runtime relies on ELF ifunc and symbol
    # renaming and fails to link on Windows; build a single x86-64-v2
    # (SSE4.2) library instead.
    cmake_args="
      -DCMAKE_BUILD_TYPE=Release
      -DCMAKE_POSITION_INDEPENDENT_CODE=ON
      -DBUILD_SHARED_LIBS=OFF
      -DBUILD_STATIC_LIBS=ON
      -DBUILD_UNIT=OFF
      -DBUILD_TOOLS=OFF
      -DBUILD_EXAMPLES=OFF
      -DBUILD_BENCHMARKS=OFF
      -DBUILD_DOC=OFF
      -DHS_C_FLAGS=-Wno-error
      -DHS_CXX_FLAGS=-Wno-error
      -DNO_SIMDE_IN_FAT=ON
      -DFAT_RUNTIME=OFF
      -DCMAKE_INSTALL_LIBDIR=lib
    "

    # Boost headers: an explicit root, else the BH package (LinkingTo).
    boost_root="$VECTORSCAN_BOOST_ROOT"
    if [ -z "$boost_root" ]; then
      boost_root="$("${R_HOME}/bin${R_ARCH_BIN}/Rscript.exe" -e 'cat(system.file(package = "BH"))' 2>/dev/null || true)"
    fi

    # Build with R's (Rtools) compilers and make, never a Visual Studio
    # generator: MSVC objects cannot be linked into the package.
    cc_bin="$("${R_HOME}/bin${R_ARCH_BIN}/R.exe" CMD config CC | cut -d' ' -f1)"
    cxx_bin="$("${R_HOME}/bin${R_ARCH_BIN}/R.exe" CMD config CXX17 | cut -d' ' -f1)"
    if [ -n "$VECTORSCAN_CMAKE_ARGS" ]; then
      cmake_args="$cmake_args $VECTORSCAN_CMAKE_ARGS"
    fi

    jobs="${VECTORSCAN_BUILD_JOBS:-2}"
    install_prefix="$(pwd)/$BUNDLED_INSTALL_DIR"

    rm -rf "$BUNDLED_BUILD_DIR" "$BUNDLED_INSTALL_DIR"

    echo "configure.win: building bundled Vectorscan"
    # shellcheck disable=SC2086
    # R's package compile flags are for R code, not the vendored build (see
    # configure); keep them away from CMake.
    (
      unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
      cmake -S "$BUNDLED_SOURCE_DIR" -B "$BUNDLED_BUILD_DIR" -G "Unix Makefiles" $cmake_args \
        ${boost_root:+"-DBOOST_ROOT=$boost_root"} \
        ${boost_root:+"-DBoost_NO_SYSTEM_PATHS=ON"} \
        ${cc_bin:+"-DCMAKE_C_COMPILER=$cc_bin"} \
        ${cxx_bin:+"-DCMAKE_CXX_COMPILER=$cxx_bin"}
    )
    cmake --build "$BUNDLED_BUILD_DIR" --target hs --config Release -j "$jobs"
    cmake --build "$BUNDLED_BUILD_DIR" --target hs_runtime --config Release -j "$jobs"
    cmake --install "$BUNDLED_BUILD_DIR" --prefix "$install_prefix"
    rm -rf "$BUNDLED_BUILD_DIR"

    if [ -f "$BUNDLED_INSTALL_DIR/lib/libhs.a" ]; then
      PKG_CPPFLAGS="-DHAVE_HS -Ivendor/vectorscan-install/include"
      PKG_LIBS="vendor/vectorscan-install/lib/libhs.a vendor/vectorscan-install/lib/libhs_runtime.a"
      FOUND_HS=yes
    elif [ -f "$BUNDLED_INSTALL_DIR/lib/hs.lib" ]; then
      PKG_CPPFLAGS="-DHAVE_HS -Ivendor/vectorscan-install/include"
      PKG_LIBS="vendor/vectorscan-install/lib/hs.lib vendor/vectorscan-install/lib/hs_runtime.lib"
      FOUND_HS=yes
    fi
  fi
fi

if [ "$FOUND_HS" = no ] && [ "$VECTORSCAN_ALLOW_STUBS" != "true" ] && [ "$VECTORSCAN_ALLOW_STUBS" != "1" ]; then
  echo "configure.win: failed to build bundled Vectorscan"
  echo "configure.win: install cmake, or set VECTORSCAN_USE_SYSTEM=true"
  exit 1
fi

# -- PCRE2, for hs_capture() -------------------------------------------------
#
# Same routes as configure (VECTORSCAN_PCRE2 = auto, system, vendored, none).
# The system PCRE2 on Windows is the one Rtools ships, as a static library:
# found through Rtools' pkg-config, else by linking -lpcre2-8 directly.
# PCRE2_STATIC stops pcre2.h from declaring the API as DLL imports.

FOUND_PCRE2=no
PCRE2_SOURCE_DIR="src/vendor/pcre2"
PCRE2_BUILD_DIR="${TMPDIR:-/tmp}/vectorscan-pcre2-build-$$"
PCRE2_INSTALL_DIR="src/vendor/pcre2-install"
R_EXE="${R_HOME}/bin${R_ARCH_BIN}/R.exe"

find_system_pcre2_win() {
  if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists libpcre2-8 2>/dev/null; then
    PCRE2_CPPFLAGS="-DPCRE2_STATIC $(pkg-config --cflags libpcre2-8)"
    PCRE2_LIBS="$(pkg-config --libs --static libpcre2-8)"
    PCRE2_VERSION="$(pkg-config --modversion libpcre2-8)"
    FOUND_PCRE2=system
    return 0
  fi
  cc="$("$R_EXE" CMD config CC)"
  probe="${TMPDIR:-/tmp}/vectorscan-pcre2-probe-$$"
  printf '%s\n' '#define PCRE2_CODE_UNIT_WIDTH 8' '#define PCRE2_STATIC' \
    '#include <pcre2.h>' \
    'int main(void) { return pcre2_config(PCRE2_CONFIG_UNICODE, 0) < 0; }' > "$probe.c"
  # shellcheck disable=SC2086
  if $cc "$probe.c" -lpcre2-8 -o "$probe.exe" >/dev/null 2>&1; then
    rm -f "$probe.c" "$probe.exe"
    PCRE2_CPPFLAGS="-DPCRE2_STATIC"
    PCRE2_LIBS="-lpcre2-8"
    PCRE2_VERSION="Rtools"
    FOUND_PCRE2=system
    return 0
  fi
  rm -f "$probe.c" "$probe.exe"
  return 1
}

build_vendored_pcre2_win() {
  if [ ! -f "$PCRE2_SOURCE_DIR/CMakeLists.txt" ] || ! command -v cmake >/dev/null 2>&1; then
    return 1
  fi
  rm -rf "$PCRE2_BUILD_DIR" "$PCRE2_INSTALL_DIR"
  echo "configure.win: building vendored PCRE2"
  cc_bin="$("$R_EXE" CMD config CC | cut -d' ' -f1)"
  (
    unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
    cmake -S "$PCRE2_SOURCE_DIR" -B "$PCRE2_BUILD_DIR" -G "Unix Makefiles" \
      ${cc_bin:+"-DCMAKE_C_COMPILER=$cc_bin"} \
      -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DBUILD_STATIC_LIBS=ON \
      -DPCRE2_STATIC_PIC=ON -DPCRE2_BUILD_PCRE2GREP=OFF -DPCRE2_BUILD_TESTS=OFF \
      -DPCRE2_SUPPORT_JIT=ON -DPCRE2_SUPPORT_UNICODE=ON -DHAVE_VISIBILITY=OFF &&
      cmake --build "$PCRE2_BUILD_DIR" --target pcre2-8-static --config Release \
        -j "${VECTORSCAN_BUILD_JOBS:-2}" &&
      mkdir -p "$PCRE2_INSTALL_DIR/lib" "$PCRE2_INSTALL_DIR/include" &&
      cp "$PCRE2_BUILD_DIR/libpcre2-8.a" "$PCRE2_INSTALL_DIR/lib/" &&
      cp "$PCRE2_BUILD_DIR/interface/pcre2.h" "$PCRE2_INSTALL_DIR/include/"
  ) || { rm -rf "$PCRE2_BUILD_DIR"; return 1; }
  rm -rf "$PCRE2_BUILD_DIR"
  PCRE2_CPPFLAGS="-DPCRE2_STATIC -Ivendor/pcre2-install/include"
  PCRE2_LIBS="vendor/pcre2-install/lib/libpcre2-8.a"
  PCRE2_VERSION="vendored"
  FOUND_PCRE2=vendored
  return 0
}

case "${VECTORSCAN_PCRE2:-auto}" in
  auto) find_system_pcre2_win || build_vendored_pcre2_win || true ;;
  system)
    if ! find_system_pcre2_win; then
      echo "configure.win: VECTORSCAN_PCRE2=system but Rtools' PCRE2 was not found"
      exit 1
    fi
    ;;
  vendored)
    if ! build_vendored_pcre2_win; then
      echo "configure.win: VECTORSCAN_PCRE2=vendored but the vendored PCRE2 did not build"
      exit 1
    fi
    ;;
  none) ;;
  *)
    echo "configure.win: VECTORSCAN_PCRE2 must be auto, system, vendored or none"
    exit 1
    ;;
esac

if [ "$FOUND_PCRE2" != no ]; then
  PKG_CPPFLAGS="$PKG_CPPFLAGS -DHAVE_PCRE2 -DPCRE2_CODE_UNIT_WIDTH=8 $PCRE2_CPPFLAGS"
  if [ "$FOUND_PCRE2" = vendored ]; then
    PKG_CPPFLAGS="$PKG_CPPFLAGS -DVCTRSN_PCRE2_VENDORED"
  fi
  PKG_LIBS="$PKG_LIBS $PCRE2_LIBS"
  echo "configure.win: PCRE2 $PCRE2_VERSION ($FOUND_PCRE2)"
else
  echo "configure.win: PCRE2 not available; hs_capture() will be unavailable"
fi

cat > src/Makevars.win <<EOF
CXX_STD = CXX17
PKG_CPPFLAGS = $PKG_CPPFLAGS
PKG_LIBS = $PKG_LIBS
EOF

if [ "$FOUND_HS" = yes ]; then
  echo "configure.win: Vectorscan/Hyperscan support enabled"
else
  echo "configure.win: Vectorscan/Hyperscan not found; building package with runtime stubs"
  echo "configure.win: set VECTORSCAN_ALLOW_STUBS only for wrapper development"
fi

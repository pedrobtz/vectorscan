#!/bin/sh
# Fetch, verify, trim, patch and generate a vendored source, then record it.
#
#   tools/vendor/fetch [source ...]      (default: every source in the manifest)
#
# Network is required, and Ragel 6 for sources with generated files. This is a maintainer script; it is never
# run during R CMD INSTALL or R CMD check, which download nothing and need no
# Ragel. Afterwards `tools/vendor/verify` re-checks the result offline.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT"
MANIFEST=tools/vendor/manifest.tsv
. tools/vendor/common.sh


sources=${*:-$(manifest_sources)}

for src in $sources; do
    tag=$(manifest_field "$src" tag)
    url=$(manifest_field "$src" archive)
    want=$(manifest_field "$src" archive_sha256)
    generated=$(manifest_field "$src" generated)
    patches=$(manifest_field "$src" patches)

    printf '==> %s %s\n' "$src" "$tag"

    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    archive="$tmp/archive"

    printf '    fetching %s\n' "$url"
    curl -sSL --fail --max-time 300 -o "$archive" "$url"

    got=$(sha256_of "$archive")
    if [ "$got" != "$want" ]; then
        printf '    sha256 MISMATCH\n      expected %s\n      got      %s\n' \
            "$want" "$got" >&2
        exit 1
    fi
    printf '    sha256 ok %s\n' "$got"

    mkdir -p "$tmp/x"
    case "$url" in
        *.tar.gz|*.tgz) tar -xzf "$archive" -C "$tmp/x" --strip-components=1 ;;
        *.tar.bz2) tar -xjf "$archive" -C "$tmp/x" --strip-components=1 ;;
        *) echo "    unknown archive type: $url" >&2; exit 1 ;;
    esac

    dest="src/vendor/$src"
    rm -rf "$dest"
    mkdir -p "$dest"
    kept=0
    for pair in $(keep_list "$src"); do
        to=${pair%%:*}
        from=${pair#*:}
        if [ ! -f "$tmp/x/$from" ]; then
            printf '    MISSING in archive: %s\n' "$from" >&2
            exit 1
        fi
        mkdir -p "$dest/$(dirname "$to")"
        cp "$tmp/x/$from" "$dest/$to"
        kept=$((kept + 1))
    done
    printf '    kept %s files\n' "$kept"

    for p in $(split_field "$patches"); do
        printf '    applying %s\n' "$p"
        patch -s -p1 -d "$dest" < "tools/patches/$src/$p"
    done
    # A hunk applied with an offset or fuzz leaves a .orig backup (and a
    # failed one a .rej) next to the file; neither belongs in the tree.
    if [ -n "$(find "$dest" -name '*.rej')" ]; then
        echo "    a patch left rejected hunks; refresh it against $tag" >&2
        exit 1
    fi
    find "$dest" -name '*.orig' -exec rm -f {} +

    # Each generated file is <name>.rl.cpp next to <name>.rl, produced the way
    # upstream's cmake/ragel.cmake runs Ragel, plus -L so the output carries
    # no #line paths. Run from inside the tree so nothing absolute leaks in.
    for g in $(split_field "$generated"); do
        if ! command -v ragel >/dev/null 2>&1; then
            echo "    ragel is required to generate $g" >&2
            exit 1
        fi
        rl=${g%.cpp}
        printf '    generating %s\n' "$g"
        (cd "$dest" && ragel "$rl" -o "$g" -G0 -L)
    done

    rm -rf "$tmp"
    trap - EXIT
done

printf '==> recording checksums\n'
"$ROOT/tools/vendor/record"
printf 'done. review the diff under src/vendor/ before committing.\n'

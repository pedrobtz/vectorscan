@@ -1102,7 +1108,7 @@
     u32 width = gi->stream_som_loc_width;
 
     for (u32 i = 0; i < count; i++) {
-        som->slots[i] = expandSomValue(width, curr_offset, src_som_base, i);
+        SOM_SLOTS(som)[i] = expandSomValue(width, curr_offset, src_som_base, i);
     }
 }
 
